# Copy to .env and edit.  Every value here has a working default, so an empty
# .env (or no .env at all) still runs -- see README "Configuration".

# --- Core -----------------------------------------------------------------
# Required whenever DJANGO_DEBUG=false; start-up refuses the dev default.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# Defaults to SQLite next to manage.py.  For the compose stack:
#   postgres://tradecore:tradecore@db:5432/tradecore
DATABASE_URL=

# --- Tokens ---------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=1

# --- Pagination -----------------------------------------------------------
POST_PAGE_SIZE=20
POST_MAX_PAGE_SIZE=100

# --- Providers ------------------------------------------------------------
# Each is "auto" (use the real service when its key is set, else the offline
# fallback), or pinned explicitly.
# GEOLOCATION_PROVIDER: auto | abstractapi | null
# HOLIDAY_PROVIDER:     auto | abstractapi | null
# MODERATION_PROVIDER:  auto | claude | keyword
GEOLOCATION_PROVIDER=auto
HOLIDAY_PROVIDER=auto
MODERATION_PROVIDER=auto

ABSTRACT_GEOLOCATION_API_KEY=
ABSTRACT_HOLIDAYS_API_KEY=
ANTHROPIC_API_KEY=
MODERATION_MODEL=claude-opus-5

PROVIDER_HTTP_TIMEOUT_SECONDS=5
PROVIDER_HTTP_MAX_RETRIES=2
GEOLOCATION_CACHE_SECONDS=86400
HOLIDAY_CACHE_SECONDS=21600
